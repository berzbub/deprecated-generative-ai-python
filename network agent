async def analyze_network():
    """API endpoint to trigger network analysis."""
    try:
        bluetooth_scanner = BluetoothScanner()
        wifi_scanner = WifiScanner()
        
        # Collect data
        network_data = network_scanner.scan_network("192.168.1.0/24")
