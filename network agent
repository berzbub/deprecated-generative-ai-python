class BluetoothScanner:
    """Scans for both Bluetooth Classic and Bluetooth Low Energy devices."""
    def __init__(self):
        self.logger = logging.getLogger(__name__)

    def scan_bluetooth_classic(self):
        try:
            devices = bluetooth.discover_devices(
                duration=8,
                lookup_names=True,
                lookup_class=True
            )
            return [{
                'address': addr,
                'name': name,
                'class': dev_class
            } for addr, name, dev_class in devices]
        except Exception as e:
            self.logger.error(f"Bluetooth classic scan error: {str(e)}")
            return []

    def scan_bluetooth_le(self):
        try:
            service = DiscoveryService()
            devices = service.discover(2)
            return [{
                'address': addr,
                'name': name
            } for addr, name in devices.items()]
        except Exception as e:
            self.logger.error(f"Bluetooth LE scan error: {str(e)}")
            return []

class WifiScanner:
    """Scans Wi-Fi devices with configurable SSID patterns for rescue use cases."""
    def __init__(self):
        self.logger = logging.getLogger(__name__)
        
    def scan_wifi_devices(self, interface="wlan0", ssid_patterns=None):
        try:
            devices = []
            if ssid_patterns is None:
                ssid_patterns = [
                    "cam",
                    "ipcam",
                    "camera",
                    "webcam",
                    "drone",
                    "uav",
                    "dji",
                    "mavic",
                    "atv",
                    "rescue",
                ]
            
            def packet_handler(pkt):
                if pkt.haslayer(Dot11):
                    if pkt.type == 0 and pkt.subtype == 8:  # Beacon frame
                        if pkt.info:  # SSID
                            ssid = pkt.info.decode('utf-8', errors='ignore')
                            # Check for common camera/drone/rescue SSID patterns
                            if any(pattern in ssid.lower() for pattern in ssid_patterns):
                                signal_strength = -100
                                if pkt.haslayer(RadioTap) and hasattr(pkt[RadioTap], "dBm_AntSignal"):
                                    signal_strength = pkt[RadioTap].dBm_AntSignal
                                devices.append({
                                    'ssid': ssid,
                                    'bssid': pkt.addr2,
                                    'signal_strength': signal_strength
                                })
            
            # Monitor mode might be required
            sniff(iface=interface, prn=packet_handler, timeout=10)
            return devices
            
        except Exception as e:
            self.logger.error(f"WiFi device scan error: {str(e)}")
            return []

    def scan_wifi_cameras(self, interface="wlan0"):
        return self.scan_wifi_devices(
            interface=interface,
            ssid_patterns=["cam", "ipcam", "camera", "webcam"],
        )

class GeminiAIAnalyzer:
    """Uses Gemini-Pro to analyze network data and provide recommendations."""
    def __init__(self, project_id, location):
        vertexai.init(project=project_id, location=location)
        self.model = TextGenerationModel.from_pretrained("gemini-pro")
        
    async def analyze_network_data(self, network_data):
        prompt = f"""
        Analyze the following network data to support search-and-rescue terrain mapping in
        off-road areas. Include insights that improve field operations for ATV teams and
        Mavic Pro drone-assisted rescue missions:
        Network Devices: {network_data['devices']}
        Signal Strengths: {network_data['signals']}
        Traffic Patterns: {network_data['traffic']}
        """
        response = await self.model.predict_async(prompt)
        return response.text

    async def generate_security_recommendations(self, scan_results):
        prompt = f"""
        Based on the network scan results, provide operational and security recommendations
        for resilient search-and-rescue mapping where roads are unavailable:
        {scan_results}
        """
        response = await self.model.predict_async(prompt)
        return response.text
        
